# PravixoEduTech backend environment template.
# Copy to .env and replace placeholders.
# Never commit the real .env file.

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

PUBLIC_TENANT_ID=pravixoedutech

# Hosted public registration is closed unless this is exactly "true".
PUBLIC_REGISTRATION_ENABLED=false
# Hosted public registration requires an explicit trusted tenant slug.
PUBLIC_REGISTRATION_TENANT_ID=pravixoedutech

# One exact frontend origin:
FRONTEND_URL=http://localhost:3000

# Multiple exact origins instead:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required when Razorpay payments are enabled:
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me

# Dedicated secret configured for the Razorpay webhook endpoint.
# Keep this separate from RAZORPAY_KEY_SECRET.
# RAZORPAY_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Password reset / transactional email configuration:
# Hosted environments must use the exact trusted HTTPS frontend origin.
PASSWORD_RESET_FRONTEND_ORIGIN=

# Student email verification links use the same trusted-origin policy.
EMAIL_VERIFICATION_FRONTEND_ORIGIN=

# Postmark server-scoped sending credential. Never use an account token here.
POSTMARK_SERVER_TOKEN=

# Verified sender address configured in Postmark.
POSTMARK_FROM_EMAIL=

# Transactional Postmark message stream.
POSTMARK_MESSAGE_STREAM=outbound
